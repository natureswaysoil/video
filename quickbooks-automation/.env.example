PORT=8080
QBO_ENV=sandbox
GOOGLE_CLOUD_PROJECT=natureswaysoil-video

# Intuit Developer app credentials
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://YOUR-CLOUD-RUN-URL/oauth/callback
QBO_SECRET_PREFIX=qbo

# Safety switch. Leave false until sandbox tests pass.
QBO_WRITE_ENABLED=false

# QuickBooks chart-of-accounts mappings. You may use an account ID or exact account name.
QBO_ACCOUNT_BANK=Amazon Clearing
QBO_ACCOUNT_SALES=Sales of Product Income
QBO_ACCOUNT_SHIPPING_INCOME=Shipping Income
QBO_ACCOUNT_REFUNDS=Refunds-Allowances
QBO_ACCOUNT_REFERRAL_FEES=Amazon Fees
QBO_ACCOUNT_FULFILLMENT_FEES=Fulfillment Fees
QBO_ACCOUNT_ADVERTISING=Advertising
